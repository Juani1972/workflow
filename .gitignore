# Real credentials — never commit. .env.example files ARE
# committed (they're empty templates); this only blocks real .env
# files, in any folder of the repo.
.env
*.env
!*.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/

# GUI's SQLite — local data from each installation, not part of the repo.
fika-sync/gui/fika_sync.db
fika-sync/gui/*.db-journal

# Node (if some module ever needs it later on)
node_modules/

# SQLite generated by webapp backend tests
webapp/backend/*.db
