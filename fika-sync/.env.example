# Copy to .env and fill in with TEST/sandbox credentials.
# Never commit the real .env nor production credentials.

# Cal.com (via modules/calcom-pro) — simple API key, not OAuth.
CALCOM_API_KEY=

# Google Calendar + Sheets (via modules/gcal, modules/sheets)
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET identify the Fika Sync
# APPLICATION to Google — they're the same for every user, configured
# by whoever deploys the app (see "Create the OAuth Client" in
# fika-sync/gui/README.md).
#
# GOOGLE_REFRESH_TOKEN is optional now that the "Connect Google" flow
# with one click exists in the GUI (fika-sync/gui/oauth_service.py):
# if you leave it empty, each user connects their own account from
# the GUI and the refresh token gets saved in fika_sync.db, not here.
# Only fill in this variable if you prefer the manual developer flow
# (generating a token yourself via OAuth Playground, see
# VALIDATION.md) instead of the GUI flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Slack (via modules/slack)
#
# SLACK_CLIENT_ID / SLACK_CLIENT_SECRET are for the "Connect Slack"
# with one click GUI flow — they identify the Fika Sync app to Slack
# (App Credentials at api.slack.com/apps → Basic Information).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
#
# SLACK_BOT_TOKEN / SLACK_SIGNING_SECRET are for the manual developer
# flow (installing the app by hand and copying the token) — an
# alternative to the GUI flow, same as GOOGLE_REFRESH_TOKEN above.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Sheets (v0.2.0, export_to_sheet / log_history) — reuses the Google
# credentials above, this is just the sheet's ID.
SHEETS_SPREADSHEET_ID=

# Zoom (v0.2.0, get_actual_duration)
ZOOM_API_KEY=
ZOOM_API_SECRET=
